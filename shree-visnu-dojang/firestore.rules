rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "bikrammajhidev@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.keys().hasOnly([
          "studentName",
          "contactInfo",
          "ageGroup",
          "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "studentName",
          "contactInfo",
          "ageGroup",
          "createdAt"
        ])
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 100
        && request.resource.data.contactInfo is string
        && request.resource.data.contactInfo.size() >= 3
        && request.resource.data.contactInfo.size() <= 120
        && request.resource.data.ageGroup in [
          "kids",
          "teens",
          "adults",
          "sparring"
        ]
        && request.resource.data.createdAt == request.time;

      allow read, delete: if isAdmin();
    }
  }
}
